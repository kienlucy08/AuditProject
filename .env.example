# Copy to .env and fill in. Never commit .env.
export PG_HOST=localhost
export PG_PORT=5432
export PG_DB=yourdb
export PG_USER=readonly_user
export PG_PASSWORD=changeme

# ArcGIS Online / Portal. Use an admin account OR an OAuth app (client credentials).
export ARCGIS_PORTAL_URL=https://www.arcgis.com
export ARCGIS_USERNAME=
export ARCGIS_PASSWORD=
